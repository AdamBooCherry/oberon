[sub_resource type="GDScript" id="GDScript_t0wn3"]
script/source = "extends Label

func _ready() -> void:
	GameManager.oberon_score_changed.connect(_oberon_point)
	GameManager.player_score_changed.connect(_dad_point)

func _oberon_point(_value):
	text = \"Round Lost!\"

func _dad_point(_value):
	text = \"Round Won!\"
"

[sub_resource type="GDScript" id="GDScript_qtxv5"]
script/source = "extends Label

func _ready() -> void:
	GameManager.oberon_score_changed.connect(_on_score_changed)
	GameManager.player_score_changed.connect(_on_score_changed)

func _on_score_changed(_value):
	text = str(GameManager.player_score) + \" - \" + str(GameManager.oberon_score)
	pass
"

