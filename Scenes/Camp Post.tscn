script/source = "extends Label3D

func _ready() -> void:
	GameManager.oberon_score_changed.connect(_on_score_changed)
	GameManager.player_score_changed.connect(_on_score_changed)
	_update_text()

func _on_score_changed(_value):
	_update_text()

func _update_text():
	text = str(GameManager.cost_of_postage)
"

