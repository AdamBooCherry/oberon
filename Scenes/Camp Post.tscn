[sub_resource type="GDScript" id="GDScript_1qq0c"]
script/source = "## orchestrator script for an interaction with a 
extends Node3D

@export var timeline: DialogicTimeline
@export var interaction_area: InteractionArea
@export var oberon: Oberon

func _ready() -> void:
	interaction_area.player_interaction_started.connect(_on_interaction_started)

func _on_interaction_started():
	Dialogic.start(timeline,\"STANDARD\")
	oberon.animation_player.play(\"Salsa\", 1)
	
	await Dialogic.timeline_ended
	
	oberon.animation_player.play(\"Float\", 3)
"

[sub_resource type="SphereShape3D" id="SphereShape3D_ohe8u"]
radius = 4.865

[sub_resource type="GDScript" id="GDScript_4hc50"]
script/source = "extends Node3D

@export var interaction_area: InteractionArea
@export var postmaster: CharacterBody3D
@export var post_office: DialogicTimeline

var has_been_interacted_with: bool = false

func _ready() -> void:
	interaction_area.player_interaction_started.connect(_on_interaction_started)
	Dialogic.signal_event.connect(_on_dialogic_signal)

func _on_interaction_started():
	if has_been_interacted_with == false:
		print(has_been_interacted_with)
		Dialogic.start(post_office, 0)
		has_been_interacted_with = true
	
	elif has_been_interacted_with == true:
		print(has_been_interacted_with)
		Dialogic.start(post_office, \"STANDARD\")

func _on_dialogic_signal(argument: Variant):
	if argument is not String:
		return
	
	if argument == \"POSTMASTER_SHOOT\":
		_shoot_player()
	elif argument == \"WIN_GAME\":
		_win_game()

func _shoot_player():
	get_tree().quit()

func _win_game():
	## play animation of postmaster mailing frog
	## after a beat you get a \"YOU'RE WINNER!\"
	## restart game
	pass
"

