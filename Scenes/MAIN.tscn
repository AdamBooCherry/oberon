[sub_resource type="GDScript" id="GDScript_csh6n"]
script/source = "extends Label

func _ready() -> void:
	InventoryManager.currency_changed.connect(_on_currency_changed)
	text = str(InventoryManager.current_currency)

func _on_currency_changed(_new_amount: int):
	## tween a bounce for every update
	text = str(InventoryManager.current_currency)
"

