[sub_resource type="GDScript" id="GDScript_0c8vy"]
script/source = "extends Camera3D

func _ready() -> void:
	CameraManager.change_to_debug_camera.connect(_switch_to_debug)
	
func _switch_to_debug():
	make_current()
	pass
"

[sub_resource type="GDScript" id="GDScript_y2jqa"]
script/source = "extends VisibleOnScreenNotifier3D

func _ready() -> void:
	screen_exited.connect(_on_screen_exited)
	

func _on_screen_exited():
	CameraManager.start_off_camera_timer()
"

