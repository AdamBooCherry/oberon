[sub_resource type="GDScript" id="GDScript_wuii1"]
script/source = "### THIS HELPER SCRIPT SUCKS BUT THE OUTLINE RENDERS WRONG WITHOUT IT ###
extends Node

@export var cool_outline: StandardMaterial3D

func _ready() -> void:
	cool_outline.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
"

