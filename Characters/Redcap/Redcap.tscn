[sub_resource type="GDScript" id="GDScript_25gn7"]
script/source = "extends Label3D

@export var redcap_state_machine: StateMachine

func _ready() -> void:
	redcap_state_machine.state_changed.connect(_on_state_changed)
	update_text()

func _on_state_changed(_value):
	update_text()

func update_text():
	text = str(redcap_state_machine.current_state)
"

